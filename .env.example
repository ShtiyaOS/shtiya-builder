# Copy to .env.local (already gitignored) and fill in real values.
# For local dev / CI, `supabase start` prints these — see `supabase status -o env`.

NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_ANON_KEY=
GEMINI_API_KEY=
# Same value as GEMINI_API_KEY — @ai-sdk/google reads this name (see /api/copilot).
GOOGLE_GENERATIVE_AI_API_KEY=
GOOGLE_APPLICATION_CREDENTIALS=
TRACERFY_API_KEY=

# Used by the app itself (src/lib/supabase/admin.ts) for the public lead
# funnel's property-match lookup (POST /api/leads bypasses RLS there on
# purpose — see admin.ts), and by tests/e2e (seed/teardown fixtures,
# admin-creating per-role auth users). Never exposed to the browser — no
# NEXT_PUBLIC_ prefix. In CI/local dev this comes from `supabase status -o env`.
SUPABASE_SERVICE_ROLE_KEY=

# Leave these three unset for local dev and CI. When unset, POST
# /api/escrow/release and POST /api/draws/approve both skip the on-chain
# call and take their built-in mock-tx-hash / DB-only fallback path — which
# is what tests/e2e/deal-lifecycle.spec.ts relies on for determinism.
# ESCROW_RPC_URL=
# ESCROW_CONTRACT_ADDRESS=
# ESCROW_PRIVATE_KEY=

# ── v3.0 additions ────────────────────────────────────────────────────────────
# Required by POST /api/copilot (Agent Factory — multi-agent Supervisor-Worker routing).
OPENAI_API_KEY=

# Required by POST /api/vault/tenant-corpus (Zero-Trust MicroVM ingestion pipeline).
# Set MICROVM_PROVIDER to one of: firecracker | gvisor | kata
MICROVM_PROVIDER_KEY=
MICROVM_PROVIDER=firecracker

# Provider-specific public keys for MicroVM proof verification.
# One per supported provider — leave unset for providers not in use.
MICROVM_PUBKEY_FIRECRACKER=
MICROVM_PUBKEY_GVISOR=
MICROVM_PUBKEY_KATA=

# Entailment classifier endpoint (Output Gate — Check 2).
# Leave unset in local dev to skip entailment scoring (gate passes vacuously).
ENTAILMENT_ENDPOINT=

# Internal API key for agent lifecycle routes (/api/agents/*).
# Server-only — no NEXT_PUBLIC_ prefix.
INTERNAL_API_KEY=

# Secrets store endpoint for agent system prompts (only the hash is stored in DB).
SECRETS_STORE_ENDPOINT=
